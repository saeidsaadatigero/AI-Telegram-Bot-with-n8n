# کلید API سرویس OpenAI - از https://platform.openai.com/api-keys بگیرید
OPENAI_API_KEY=sk-proj-XXXX

# توکن ربات تلگرام - از @BotFather دریافت کنید
TELEGRAM_BOT_TOKEN=XXXX

# شناسه عددی چت ادمین برای دریافت پیام‌های خطا (اختیاری)
TELEGRAM_ADMIN_CHAT_ID=123456789

# تنظیمات میزبانی n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# منطقه زمانی اجرای Workflow ها
GENERIC_TIMEZONE=Asia/Tehran

# اجازه خواندن متغیرهای محیطی در Expression های n8n
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
